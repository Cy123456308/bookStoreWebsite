# Render 建议环境变量

# CORS: 允许你的 Sakura 前端域名访问
# 多个域名用逗号分隔
CORS_ORIGINS=https://your-frontend-domain.example

# 用于返回上传文件绝对 URL（推荐配置）
PUBLIC_BASE_URL=https://your-render-service.onrender.com

# 上传目录（建议绑定 Render Persistent Disk 到 /var/data）
UPLOAD_DIR=/var/data/uploads

# 二选一：
# 1) 使用 SQLite（配合 Persistent Disk）
SQLITE_PATH=/var/data/site.db

# 2) 使用 Render Postgres（若启用数据库）
# DATABASE_URL=postgresql://...

# 生产默认建议关闭调试
FLASK_DEBUG=0
